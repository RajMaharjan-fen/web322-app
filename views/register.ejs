<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            mygreen: '#1DB954',
            mydark: '#121212',
            mylight: '#282828'
          }
        }
      }
    }
  </script>

  <title>Register</title>
</head>

<body class="bg-mydark min-h-screen flex flex-col">
  <main class="flex-grow container mx-auto p-4 max-w-md flex items-center justify-center">
    <div class="bg-mylight text-white p-8 rounded-lg shadow-lg w-full">
      <h1 class="text-3xl font-bold mb-10 text-center">Sign up</h1>
      
      <form method="POST" action="/register" class="space-y-6">
        <div class="space-y-2">
          <label for="email" class="block text-sm font-medium">Email address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            value="<%= email %>" 
            required 
            class="w-full px-4 py-3 bg-mylight border border-gray-600 rounded focus:outline-none focus:border-mygreen focus:ring-1 focus:ring-mygreen"
          />
        </div>
        
        <div class="space-y-2">
          <label for="userName" class="block text-sm font-medium">Create a username</label>
          <input 
            type="text" 
            id="userName" 
            name="userName" 
            value="<%= userName %>" 
            required 
            class="w-full px-4 py-3 bg-mylight border border-gray-600 rounded focus:outline-none focus:border-mygreen focus:ring-1 focus:ring-mygreen"
          />
        </div>
        
        <div class="space-y-2">
          <label for="password" class="block text-sm font-medium">Create a password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            class="w-full px-4 py-3 bg-mylight border border-gray-600 rounded focus:outline-none focus:border-mygreen focus:ring-1 focus:ring-mygreen"
          />
        </div>
        
        <div class="space-y-2">
          <label for="password2" class="block text-sm font-medium">Confirm your password</label>
          <input 
            type="password" 
            id="password2" 
            name="password2" 
            required 
            class="w-full px-4 py-3 bg-mylight border border-gray-600 rounded focus:outline-none focus:border-mygreen focus:ring-1 focus:ring-mygreen"
          />
        </div>
        
        <button 
          type="submit" 
          class="w-full py-3 bg-mygreen text-black font-bold rounded-full"
        >
          Sign Up
        </button>
      
        <div class="border-t border-gray-700 my-6"></div>
        
        <div class="text-center">
          <p class="text-gray-400">Already have an account? 
            <a href="/login" class="text-white hover:underline font-bold">Log in</a>
          </p>
        </div>
      
        <% if (errorMessage) { %>
          <div class="mt-6 p-3 bg-red-900 text-white rounded text-sm flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><%= errorMessage %></span>
          </div>
        <% } %>

        <% if (successMessage) { %>
          <div class="mt-6 p-3 bg-green-700 text-white rounded text-sm">
            <strong>Success:</strong> <%= successMessage %><br />
            <a class="mt-2 inline-block text-mygreen font-bold hover:underline" href="/login">→ Proceed to Log In</a>
          </div>
        <% } %>
      </form>
    </div>
  </main>
</body>
</html>
